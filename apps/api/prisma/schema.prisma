generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationOnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

enum OrganizationOnboardingStep {
  ORGANIZATION_SETUP
  GRC_GOALS
  FRAMEWORKS
  MEMBERS
  DEFAULTS
  REVIEW
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum FrameworkCatalogStatus {
  ACTIVE
  DEPRECATED
  HIDDEN
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RiskStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum RiskAssessmentType {
  INHERENT
  RESIDUAL
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskTreatmentStrategy {
  MITIGATE
  ACCEPT
  AVOID
  TRANSFER
}

enum RiskTreatmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
}

enum ControlAutomationType {
  MANUAL
  AUTOMATED
  HYBRID
}

enum ControlFrequency {
  CONTINUOUS
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AD_HOC
}

enum ControlStatus {
  DRAFT
  ACTIVE
  RETIRED
  ARCHIVED
}

enum ControlExecutionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrganizationFrameworkStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationRequirementStatus {
  NOT_ASSESSED
  IN_PROGRESS
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique
  passwordHash        String
  status              UserStatus   @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  memberships         Membership[]
  sessions            Session[]
  acceptedInvitations Invitation[] @relation("InvitationAcceptedByUser")

  @@index([status])
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  refreshTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model Organization {
  id                       String                           @id @default(uuid()) @db.Uuid
  slug                     String                           @unique
  name                     String
  status                   OrganizationStatus               @default(PENDING_ONBOARDING)
  timezone                 String?
  locale                   String?
  onboardingCompletedAt    DateTime?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  memberships              Membership[]
  roles                    Role[]
  onboarding               OrganizationOnboarding?
  invitations              Invitation[]
  frameworkSelections      OrganizationFrameworkSelection[]
  organizationFrameworks   OrganizationFramework[]
  organizationRequirements OrganizationRequirement[]
  requirementAssessments   RequirementAssessment[]
  requirementControls      RequirementControl[]
  risks                    Risk[]
  riskAssessments          RiskAssessment[]
  riskTreatments           RiskTreatment[]
  controls                 Control[]
  controlExecutions        ControlExecution[]
  riskControls             RiskControl[]

  @@index([status, updatedAt])
}

model Membership {
  id                            String                           @id @default(uuid()) @db.Uuid
  organizationId                String                           @db.Uuid
  userId                        String                           @db.Uuid
  status                        MembershipStatus                 @default(ACTIVE)
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt
  organization                  Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                          User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRoles               MembershipRole[]
  sentInvitations               Invitation[]                     @relation("InvitationInvitedByMembership")
  acceptedInvitations           Invitation[]                     @relation("InvitationAcceptedMembership")
  revokedInvitations            Invitation[]                     @relation("InvitationRevokedByMembership")
  selectedFrameworkSelections   OrganizationFrameworkSelection[] @relation("FrameworkSelectionSelectedByMembership")
  ownedOrganizationFrameworks   OrganizationFramework[]          @relation("ComplianceFrameworkOwner")
  adoptedOrganizationFrameworks OrganizationFramework[]          @relation("ComplianceFrameworkAdoptedBy")
  ownedOrganizationRequirements OrganizationRequirement[]        @relation("ComplianceRequirementOwner")
  assessedRequirements          RequirementAssessment[]
  createdRequirementControls    RequirementControl[]
  ownedRisks                    Risk[]                           @relation("RiskOwner")
  createdRisks                  Risk[]                           @relation("RiskCreatedBy")
  updatedRisks                  Risk[]                           @relation("RiskUpdatedBy")
  riskAssessments               RiskAssessment[]
  ownedRiskTreatments           RiskTreatment[]                  @relation("RiskTreatmentOwner")
  acceptedRiskTreatments        RiskTreatment[]                  @relation("RiskTreatmentAcceptedBy")
  ownedControls                 Control[]                        @relation("ControlOwner")
  createdControls               Control[]                        @relation("ControlCreatedBy")
  updatedControls               Control[]                        @relation("ControlUpdatedBy")
  assignedControlExecutions     ControlExecution[]               @relation("ExecutionAssignee")
  completedControlExecutions    ControlExecution[]               @relation("ExecutionCompletedBy")
  createdControlExecutions      ControlExecution[]               @relation("ExecutionCreatedBy")
  createdRiskControls           RiskControl[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([userId, status])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  code            String
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipRoles MembershipRole[]
  invitations     Invitation[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, code])
}

model MembershipRole {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  membershipId   String     @db.Uuid
  roleId         String     @db.Uuid
  createdAt      DateTime   @default(now())
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role           Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([organizationId, membershipId])
  @@index([organizationId, roleId])
}

model OrganizationOnboarding {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @unique @db.Uuid
  status         OrganizationOnboardingStatus @default(IN_PROGRESS)
  currentStep    OrganizationOnboardingStep?
  lastStep       OrganizationOnboardingStep?
  completedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model Invitation {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @db.Uuid
  invitedByMembershipId  String           @db.Uuid
  invitedEmail           String
  invitedEmailNormalized String
  tokenHash              String           @unique
  status                 InvitationStatus @default(PENDING)
  roleId                 String           @db.Uuid
  expiresAt              DateTime
  acceptedAt             DateTime?
  acceptedByUserId       String?          @db.Uuid
  acceptedMembershipId   String?          @db.Uuid
  revokedAt              DateTime?
  revokedByMembershipId  String?          @db.Uuid
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByMembership    Membership       @relation("InvitationInvitedByMembership", fields: [organizationId, invitedByMembershipId], references: [organizationId, id], onDelete: Cascade)
  role                   Role             @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  acceptedByUser         User?            @relation("InvitationAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedMembership     Membership?      @relation("InvitationAcceptedMembership", fields: [organizationId, acceptedMembershipId], references: [organizationId, id], onDelete: Restrict)
  revokedByMembership    Membership?      @relation("InvitationRevokedByMembership", fields: [organizationId, revokedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, invitedEmailNormalized, status])
  @@index([organizationId, status])
}

model FrameworkCatalog {
  id                     String                           @id @default(uuid()) @db.Uuid
  code                   String
  version                String                           @default("legacy")
  name                   String
  description            String?
  status                 FrameworkCatalogStatus           @default(ACTIVE)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  selections             OrganizationFrameworkSelection[]
  requirements           FrameworkRequirement[]
  organizationFrameworks OrganizationFramework[]

  @@unique([code, version])
  @@index([status, code], map: "FrameworkCatalog_status_code_idx")
}

model FrameworkRequirement {
  id                       String                    @id @default(uuid()) @db.Uuid
  frameworkCatalogId       String                    @db.Uuid
  code                     String
  title                    String
  description              String?
  domain                   String?
  parentRequirementId      String?                   @db.Uuid
  sortOrder                Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  frameworkCatalog         FrameworkCatalog          @relation(fields: [frameworkCatalogId], references: [id], onDelete: Cascade)
  parentRequirement        FrameworkRequirement?     @relation("FrameworkRequirementHierarchy", fields: [frameworkCatalogId, parentRequirementId], references: [frameworkCatalogId, id], onDelete: Restrict, map: "FrameworkRequirement_frameworkCatalogId_parentRequirementId_fke")
  childRequirements        FrameworkRequirement[]    @relation("FrameworkRequirementHierarchy")
  organizationRequirements OrganizationRequirement[]

  @@unique([frameworkCatalogId, id], map: "FrameworkRequirement_frameworkCatalogId_id_key")
  @@unique([frameworkCatalogId, code], map: "FrameworkRequirement_frameworkCatalogId_code_key")
  @@index([frameworkCatalogId, sortOrder], map: "FrameworkRequirement_frameworkCatalogId_sortOrder_idx")
  @@index([frameworkCatalogId, parentRequirementId], map: "FrameworkRequirement_frameworkCatalogId_parentRequirementId_idx")
  @@index([frameworkCatalogId, domain], map: "FrameworkRequirement_frameworkCatalogId_domain_idx")
}

model OrganizationFrameworkSelection {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @db.Uuid
  frameworkCatalogId     String           @db.Uuid
  selectedByMembershipId String?          @db.Uuid
  selectedAt             DateTime         @default(now())
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkCatalog       FrameworkCatalog @relation(fields: [frameworkCatalogId], references: [id], onDelete: Restrict)
  selectedByMembership   Membership?      @relation("FrameworkSelectionSelectedByMembership", fields: [organizationId, selectedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, frameworkCatalogId])
  @@index([organizationId])
}

model OrganizationFramework {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @db.Uuid
  frameworkCatalogId    String                      @db.Uuid
  status                OrganizationFrameworkStatus @default(ACTIVE)
  ownerMembershipId     String?                     @db.Uuid
  adoptedByMembershipId String                      @db.Uuid
  adoptedAt             DateTime                    @default(now())
  targetDate            DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkCatalog      FrameworkCatalog            @relation(fields: [frameworkCatalogId], references: [id], onDelete: Restrict)
  ownerMembership       Membership?                 @relation("ComplianceFrameworkOwner", fields: [organizationId, ownerMembershipId], references: [organizationId, id], onDelete: Restrict)
  adoptedByMembership   Membership                  @relation("ComplianceFrameworkAdoptedBy", fields: [organizationId, adoptedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  requirements          OrganizationRequirement[]

  @@unique([organizationId, id], map: "OrganizationFramework_organizationId_id_key")
  @@unique([organizationId, frameworkCatalogId], map: "OrganizationFramework_organizationId_frameworkCatalogId_key")
  @@index([organizationId, status, updatedAt], map: "OrganizationFramework_organizationId_status_updatedAt_idx")
  @@index([organizationId, ownerMembershipId], map: "OrganizationFramework_organizationId_ownerMembershipId_idx")
}

model OrganizationRequirement {
  id                      String                        @id @default(uuid()) @db.Uuid
  organizationId          String                        @db.Uuid
  organizationFrameworkId String                        @db.Uuid
  frameworkRequirementId  String                        @db.Uuid
  status                  OrganizationRequirementStatus @default(NOT_ASSESSED)
  ownerMembershipId       String?                       @db.Uuid
  notes                   String?
  targetDate              DateTime?
  applicabilityReason     String?
  lastAssessedAt          DateTime?
  nextReviewAt            DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationFramework   OrganizationFramework         @relation(fields: [organizationId, organizationFrameworkId], references: [organizationId, id], onDelete: Cascade, map: "OrganizationRequirement_organizationId_organizationFrameworkId_")
  frameworkRequirement    FrameworkRequirement          @relation(fields: [frameworkRequirementId], references: [id], onDelete: Restrict)
  ownerMembership         Membership?                   @relation("ComplianceRequirementOwner", fields: [organizationId, ownerMembershipId], references: [organizationId, id], onDelete: Restrict)
  assessments             RequirementAssessment[]
  controlLinks            RequirementControl[]

  @@unique([organizationId, id], map: "OrganizationRequirement_organizationId_id_key")
  @@unique([organizationId, organizationFrameworkId, frameworkRequirementId], map: "OrganizationRequirement_org_framework_req_key")
  @@index([organizationId, status, updatedAt], map: "OrganizationRequirement_organizationId_status_updatedAt_idx")
  @@index([organizationId, ownerMembershipId], map: "OrganizationRequirement_organizationId_ownerMembershipId_idx")
  @@index([organizationId, organizationFrameworkId], map: "OrganizationRequirement_org_framework_idx")
  @@index([organizationId, frameworkRequirementId], map: "OrganizationRequirement_organizationId_frameworkRequirementId_i")
}

model RequirementAssessment {
  id                        String                        @id @default(uuid()) @db.Uuid
  organizationId            String                        @db.Uuid
  organizationRequirementId String                        @db.Uuid
  status                    OrganizationRequirementStatus
  rationale                 String
  assessedByMembershipId    String                        @db.Uuid
  assessedAt                DateTime                      @default(now())
  createdAt                 DateTime                      @default(now())
  organization              Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationRequirement   OrganizationRequirement       @relation(fields: [organizationId, organizationRequirementId], references: [organizationId, id], onDelete: Cascade, map: "RequirementAssessment_organizationId_organizationRequirementId_")
  assessedByMembership      Membership                    @relation(fields: [organizationId, assessedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "RequirementAssessment_organizationId_assessedByMembershipId_fke")

  @@index([organizationId, organizationRequirementId, assessedAt], map: "ReqAssessment_org_req_assessed_idx")
  @@index([organizationId, assessedByMembershipId], map: "RequirementAssessment_organizationId_assessedByMembershipId_idx")
}

model RequirementControl {
  id                        String                  @id @default(uuid()) @db.Uuid
  organizationId            String                  @db.Uuid
  organizationRequirementId String                  @db.Uuid
  controlId                 String                  @db.Uuid
  createdByMembershipId     String                  @db.Uuid
  createdAt                 DateTime                @default(now())
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationRequirement   OrganizationRequirement @relation(fields: [organizationId, organizationRequirementId], references: [organizationId, id], onDelete: Cascade, map: "RequirementControl_organizationId_organizationRequirementId_fke")
  control                   Control                 @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Cascade)
  createdByMembership       Membership              @relation(fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, organizationRequirementId, controlId], map: "RequirementControl_organizationId_organizationRequirementId_con")
  @@unique([organizationId, id], map: "RequirementControl_organizationId_id_key")
  @@index([organizationId, organizationRequirementId], map: "RequirementControl_organizationId_organizationRequirementId_idx")
  @@index([organizationId, controlId], map: "RequirementControl_organizationId_controlId_idx")
}

model Risk {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  code                  String
  title                 String
  description           String?
  category              String?
  status                RiskStatus       @default(DRAFT)
  ownerMembershipId     String?          @db.Uuid
  nextReviewAt          DateTime?
  lastReviewedAt        DateTime?
  createdByMembershipId String           @db.Uuid
  updatedByMembershipId String           @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  archivedAt            DateTime?
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembership       Membership?      @relation("RiskOwner", fields: [organizationId, ownerMembershipId], references: [organizationId, id], onDelete: Restrict)
  createdByMembership   Membership       @relation("RiskCreatedBy", fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict)
  updatedByMembership   Membership       @relation("RiskUpdatedBy", fields: [organizationId, updatedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  assessments           RiskAssessment[]
  treatment             RiskTreatment?
  riskControls          RiskControl[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, category])
}

model Control {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  code                  String
  title                 String
  description           String?
  category              String?
  type                  ControlType
  automationType        ControlAutomationType
  frequency             ControlFrequency
  status                ControlStatus         @default(DRAFT)
  ownerMembershipId     String?               @db.Uuid
  createdByMembershipId String                @db.Uuid
  updatedByMembershipId String                @db.Uuid
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  archivedAt            DateTime?
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembership       Membership?           @relation("ControlOwner", fields: [organizationId, ownerMembershipId], references: [organizationId, id], onDelete: Restrict)
  createdByMembership   Membership            @relation("ControlCreatedBy", fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict)
  updatedByMembership   Membership            @relation("ControlUpdatedBy", fields: [organizationId, updatedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  executions            ControlExecution[]
  riskControls          RiskControl[]
  requirementControls   RequirementControl[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, category])
}

model ControlExecution {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @db.Uuid
  controlId               String                 @db.Uuid
  periodLabel             String
  periodStart             DateTime
  periodEnd               DateTime
  dueAt                   DateTime
  status                  ControlExecutionStatus @default(SCHEDULED)
  assignedToMembershipId  String?                @db.Uuid
  startedAt               DateTime?
  completedAt             DateTime?
  completedByMembershipId String?                @db.Uuid
  completionNotes         String?
  createdByMembershipId   String                 @db.Uuid
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control                 Control                @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Cascade)
  assignedToMembership    Membership?            @relation("ExecutionAssignee", fields: [organizationId, assignedToMembershipId], references: [organizationId, id], onDelete: Restrict)
  completedByMembership   Membership?            @relation("ExecutionCompletedBy", fields: [organizationId, completedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  createdByMembership     Membership             @relation("ExecutionCreatedBy", fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, controlId, dueAt])
  @@index([organizationId, status, dueAt])
}

model RiskControl {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  riskId                String       @db.Uuid
  controlId             String       @db.Uuid
  createdByMembershipId String       @db.Uuid
  createdAt             DateTime     @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                  Risk         @relation(fields: [organizationId, riskId], references: [organizationId, id], onDelete: Cascade)
  control               Control      @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Cascade)
  createdByMembership   Membership   @relation(fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, riskId, controlId])
  @@unique([organizationId, id])
  @@index([organizationId, riskId])
  @@index([organizationId, controlId])
}

model RiskAssessment {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @db.Uuid
  riskId                 String             @db.Uuid
  type                   RiskAssessmentType
  likelihood             Int
  impact                 Int
  score                  Int
  severity               RiskSeverity
  rationale              String?
  assessedByMembershipId String             @db.Uuid
  assessedAt             DateTime           @default(now())
  createdAt              DateTime           @default(now())
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                   Risk               @relation(fields: [organizationId, riskId], references: [organizationId, id], onDelete: Cascade)
  assessedByMembership   Membership         @relation(fields: [organizationId, assessedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, riskId, type, assessedAt])
  @@index([organizationId, assessedByMembershipId])
}

model RiskTreatment {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @db.Uuid
  riskId                 String                @db.Uuid
  strategy               RiskTreatmentStrategy
  status                 RiskTreatmentStatus   @default(NOT_STARTED)
  plan                   String?
  targetDate             DateTime?
  ownerMembershipId      String?               @db.Uuid
  acceptedByMembershipId String?               @db.Uuid
  acceptedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                   Risk                  @relation(fields: [organizationId, riskId], references: [organizationId, id], onDelete: Cascade)
  ownerMembership        Membership?           @relation("RiskTreatmentOwner", fields: [organizationId, ownerMembershipId], references: [organizationId, id], onDelete: Restrict)
  acceptedByMembership   Membership?           @relation("RiskTreatmentAcceptedBy", fields: [organizationId, acceptedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, riskId])
  @@index([organizationId, status, targetDate])
  @@index([organizationId, ownerMembershipId])
}
