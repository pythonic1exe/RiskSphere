  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, type, updatedAt])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, createdByMembershipId])
  @@index([organizationId, expiresAt])
