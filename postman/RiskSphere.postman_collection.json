              "path": ["organization-invitations", "accept"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Frameworks",
      "item": [
        {
          "name": "Get Framework Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/framework-catalog",
              "host": ["{{baseUrl}}"],
              "path": ["framework-catalog"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (Array.isArray(data?.frameworks) && data.frameworks.length > 0) {",
                  "  pm.environment.set('frameworkCatalogId', data.frameworks[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Select Framework",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{organizationId}}/framework-selections/{{frameworkCatalogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{organizationId}}", "framework-selections", "{{frameworkCatalogId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Unselect Framework",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{organizationId}}/framework-selections/{{frameworkCatalogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{organizationId}}", "framework-selections", "{{frameworkCatalogId}}"]
            }
          },
          "response": []
        }
