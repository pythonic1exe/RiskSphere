{
  "info": {
    "_postman_id": "f0c5d4fa-5bc1-4c2e-9f16-2c01d8b3a7c7",
    "name": "RiskSphere API",
    "description": "Import this collection with the RiskSphere Local environment. It covers auth, organization onboarding, invitations, and framework selection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
